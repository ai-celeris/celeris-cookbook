#!/usr/bin/env bash
# Build the cookbook site and publish it to the cookbook/ prefix of the
# assets bucket, then invalidate /cookbook/* on the docs.celeris.ai
# distribution. This is the same publish path the celeris-cookbook-deploy
# workflow runs; use it manually only with AWS credentials for the docs
# account.
#
# Required environment:
#   COOKBOOK_BUCKET           S3 bucket name (tofu output: site_bucket)
#   DOCS_DISTRIBUTION_ID      docs.celeris.ai CloudFront distribution id
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"

: "${COOKBOOK_BUCKET:?set COOKBOOK_BUCKET (see infra/ outputs)}"
: "${DOCS_DISTRIBUTION_ID:?set DOCS_DISTRIBUTION_ID (docs.celeris.ai distribution)}"

python3 -m pip install --quiet -r "$ROOT/site/requirements.txt"
python3 "$ROOT/scripts/validate.py"
BASE_URL=/cookbook/ python3 "$ROOT/site/build.py"

# --delete is safe: the sync target scopes it to the cookbook/ prefix only.
aws s3 sync "$ROOT/site/dist" "s3://$COOKBOOK_BUCKET/cookbook" --delete --no-cli-pager \
  --cache-control 'public,max-age=60,must-revalidate'
aws cloudfront create-invalidation \
  --distribution-id "$DOCS_DISTRIBUTION_ID" \
  --paths '/cookbook/*' --no-cli-pager >/dev/null

echo "deployed cookbook site to s3://$COOKBOOK_BUCKET/cookbook"
